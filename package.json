{
  "name": "@hello.nrfcloud.com/map-backend",
  "version": "0.0.0-development",
  "description": "Cloud backend for hello.nrfcloud.com/map developed using AWS CDK in TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --no-warnings --experimental-transform-types --test --test-reporter spec \"!(dist|node_modules)/**/*.spec.ts\"",
    "test:e2e": "node --experimental-transform-types --no-warnings ./feature-runner/run-features.ts > e2e-test-result.json && cat e2e-test-result.json | node --experimental-transform-types --no-warnings ./feature-runner/console-reporter.ts --only-failed --with-timestamps",
    "prepare": "husky && check-node-version --package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/map-backend.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/map-backend/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/map-backend#readme",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud",
    "aws",
    "cdk"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-acm": "3.901.0",
    "@aws-sdk/client-cloudwatch-logs": "3.901.0",
    "@aws-sdk/client-dynamodb": "3.902.0",
    "@aws-sdk/client-ecr": "3.901.0",
    "@aws-sdk/client-iot-data-plane": "3.901.0",
    "@aws-sdk/client-route-53": "3.901.0",
    "@bifravst/aws-cdk-ecr-helpers": "1.3.146",
    "@bifravst/aws-cdk-lambda-helpers": "3.5.139",
    "@bifravst/aws-ssm-settings-helpers": "1.2.257",
    "@bifravst/bdd-markdown": "8.2.80",
    "@bifravst/ci": "2.1.1",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/http-api-mock": "2.1.354",
    "@bifravst/prettier-config": "1.1.17",
    "@bifravst/run": "1.2.0",
    "@commitlint/config-conventional": "19.8.1",
    "@hello.nrfcloud.com/bdd-markdown-steps": "2.8.557",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.3",
    "@types/aws-lambda": "8.10.159",
    "@types/cfn-response": "1.0.8",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash-es": "4.17.12",
    "aws-cdk": "2.1033.0",
    "aws-cdk-lib": "2.232.0",
    "cdk": "2.1033.0",
    "cfn-response": "1.0.1",
    "chalk": "5.6.2",
    "check-node-version": "4.2.1",
    "commander": "14.0.2",
    "commitlint": "19.8.1",
    "constructs": "10.4.3",
    "husky": "9.1.7",
    "jsonata": "2.1.0",
    "lint-staged": "16.2.7",
    "semver": "7.7.3",
    "table": "6.9.0",
    "tsmatchers": "5.0.3"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=22.2.0",
    "npm": ">=10"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-lambda-powertools/metrics": "2.27.0",
    "@aws-sdk/client-lambda": "3.901.0",
    "@aws-sdk/client-ses": "3.901.0",
    "@aws-sdk/client-ssm": "3.901.0",
    "@aws-sdk/util-dynamodb": "3.902.0",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/random-words": "8.0.3",
    "@bifravst/timestream-helpers": "6.1.0",
    "@hello.nrfcloud.com/certificate-helpers": "1.0.0",
    "@hello.nrfcloud.com/lambda-helpers": "3.5.21",
    "@hello.nrfcloud.com/nrfcloud-api-helpers": "6.0.463",
    "@hello.nrfcloud.com/proto": "15.4.93",
    "@hello.nrfcloud.com/proto-map": "16.5.45",
    "@middy/core": "6.4.5",
    "@middy/input-output-logger": "6.4.5",
    "@sinclair/typebox": "0.34.41",
    "id128": "1.6.6",
    "jsonwebtoken": "9.0.3",
    "lodash-es": "4.17.21"
  }
}
